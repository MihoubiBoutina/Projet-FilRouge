{% extends 'base.html.twig' %}

{# Titre de la page affiché dans l’onglet du navigateur #}
{% block title %}Créer un atelier{% endblock %}

{% block body %}
<section class="formateurs-page">
    {# Titre de la page de création d’atelier #}
    <div class="titre">
        <h2 class="titre-text"><span>Créer</span> un atelier</h2>
        <p>Remplissez les informations ci-dessous.</p>
    </div>
{# FORMULAIRE DE CRÉATION #}
    {# Le formulaire envoie les données en POST vers le contrôleur #}
    <form method="post" class="atelier-form">
        {# Champ Titre #}
        <label>
            Titre
            <input type="text" name="titre" value="{{ data.titre }}" required>

            {# Récupération et affichage de l’erreur liée au titre #}
            {% set eTitre = errors['[titre]'] ?? errors['[fields][titre]'] ?? null %}
            {% if eTitre %}
                <small class="form-error">{{ eTitre[0] }}</small>
            {% endif %}
        </label>

        {# Champ Description #}
        <label>
            Description
            <textarea name="description" rows="5" required>{{ data.description }}</textarea>
            {% if errors['[description]'] is defined %}<small>{{ errors['[description]'][0] }}</small>{% endif %}
        </label>

        {# Champ Date #}
        <label>
            Date (AAAA-MM-JJ)
            <input type="date" name="date" value="{{ data.date }}" required>
            {% if errors['[date]'] is defined %}<small>{{ errors['[date]'][0] }}</small>{% endif %}
        </label>

        {# Champ Heure #}
        <label>
            Heure (HH:MM)
            <input type="time" name="heure" value="{{ data.heure }}" required>
            {% if errors['[heure]'] is defined %}<small>{{ errors['[heure]'][0] }}</small>{% endif %}
        </label>

        <label>
            Durée (minutes)
            <input type="number" name="duree" min="15" max="480" value="{{ data.duree }}" required>
            {% if errors['[duree]'] is defined %}<small>{{ errors['[duree]'][0] }}</small>{% endif %}
        </label>

        {# Champ Nombre de places #}
        <label>
            Places
            <input type="number" name="places" min="1" max="100" value="{{ data.places }}" required>
            {% if errors['[places]'] is defined %}<small>{{ errors['[places]'][0] }}</small>{% endif %}
        </label>

        {# Boutons d’action  #}
        <div style="display:flex; gap:10px; justify-content:center; margin-top:12px;">
            <button class="btn1" type="submit">Enregistrer</button>
            {# Retour vers la liste des ateliers du formateur #}
            <a class="btn2" href="{{ path('app_ateliers_index') }}">Retour</a>
        </div>
    </form>
</section>
{% endblock %}
