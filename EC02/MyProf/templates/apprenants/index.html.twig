{% extends 'base.html.twig' %}

{% block title %}Avis des apprenants{% endblock %}

{% block body %}

<section class="apprenants-page">
    <div class="titre">
        <h2 class="titre-text"><span>Avis</span> des apprenants</h2>
        <p>Découvrez ce que pensent nos apprenants</p>
    </div>

    {# LISTE DES AVIS #}

    <div class="avis-grid">
    {# Boucle Twig pour afficher chaque avis
    transmis depuis le contrôleur #}
    {% for a in avis %}
        <article class="avis-card">
            {# Avatar (photo) de l’apprenant #}
            <div class="avis-avatar">
                <img src="{{ asset(a.photo) }}" alt="Photo de {{ a.nom }}" loading="lazy">
            </div>

            {# Nom de l’apprenant #}
            <h3 class="avis-nom">{{ a.nom }}</h3>

            {# Affichage de la note sous forme d’étoiles #}
            <div class="avis-stars">
                {% for i in 1..5 %}
                    {% if i <= a.note %}
                        <i class="fa-solid fa-star"></i>
                    {% else %}
                        <i class="fa-regular fa-star"></i>
                    {% endif %}
                {% endfor %}
            </div>

            {# Message de l’avis #}
            <p class="avis-message">
                “{{ a.message }}”
            </p>
        </article>
    {% endfor %}
</div>
</section>

{% endblock %}
