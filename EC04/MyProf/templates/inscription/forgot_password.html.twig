{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="login-page">
    <div class="login-card">
        <div class="login-header">
            <h2>Récupération <span>de compte</span></h2>
            <p>Saisissez votre email pour réinitialiser votre mot de passe</p>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert-{{ label == 'error' ? 'error' : 'success' }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}

        <form method="post">
            <div class="form-group">
                <label for="email">Votre Email</label>
                <input type="email" name="email" id="email" class="form-control" required placeholder="votre@email.com">
            </div>

            <button class="btn-login" type="submit">Vérifier mon compte</button>

            <div class="login-footer">
                <p><a href="{{ path('app_inscription') }}">Retour à la connexion</a></p>
            </div>
        </form>
    </div>
</div>
{% endblock %}